\@writefile{toc}{\contentsline {paragraph}{Stewardship Code (February 2014).}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Monthly P/B ratios for KOSPI, TOPIX, MSCI EM, and S\&P 500, January 2004--December 2024. Vertical dashed lines mark Japan's three governance reform milestones: the Stewardship Code (February 2014), the TSE Corporate Governance Code (June 2015), and the TSE P/B Reform Request (March 2023). The divergence between KOSPI and TOPIX following the 2023 mandate is the primary focus of the Japan event study in Section~4.2.}}{12}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pb_comparison}{{1}{12}{}{}{}}
\newlabel{fig:japan_es_topix}{{2a}{13}{}{}{}}
\newlabel{sub@fig:japan_es_topix}{{a}{13}{}{}{}}
\newlabel{fig:japan_es_asia}{{2b}{13}{}{}{}}
\newlabel{sub@fig:japan_es_asia}{{b}{13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cumulative abnormal spreads for Japan's three governance reform events, estimated using the stacked cohort event-study design. Each line plots the CAR from $\tau = -12$ to the post-event window end for one cohort; the base period is $\tau = -1$. Panel~(a) uses the KOSPI--TOPIX P/B spread; Panel~(b) uses the MSCI EM Asia--TOPIX P/B spread. A negative CAR indicates that Japan's benchmark (TOPIX) appreciated relative to the comparator index. The March 2023 TSE P/B Reform Request produces a persistently negative and accelerating CAR in both panels, reaching $-6.48$ P/B points (TOPIX) and $-2.58$ P/B points (Asia) at the window end. The 2014 and 2015 soft-code events produce positive CARs, indicating no commensurate Korea or EM Asia underperformance relative to trend.}}{13}{}\protected@file@percent }
\newlabel{fig:japan_es}{{2}{13}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{TSE Corporate Governance Code (June 2015).}{14}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{TSE P/B Reform Request (March 2023).}{14}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Geopolitical Risk}{15}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Korea Value-Up Event Study}{15}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces KOSPI P/B ratio by GPR escalation status, conditional on TOPIX P/B and year fixed effects. High-escalation months (GPR escalation dummy $= 1$) are defined as months in which GPRC\_KOR exceeds its 75th percentile (0.370) over 2004--2024. The OLS coefficient on the escalation dummy is $-0.016$ P/B points ($t = -0.835$, $p = 0.405$), indistinguishable from zero. The regression controls for TOPIX P/B and includes year fixed effects; $N = 252$ monthly observations. HC3 standard errors.}}{16}{}\protected@file@percent }
\newlabel{fig:geo_risk}{{3}{16}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{KOSPI--TOPIX spread.}{16}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cumulative abnormal KOSPI--TOPIX P/B spreads for Korea's three Value-Up reform milestones: program launch (February 26, 2024), guidelines unveiled (May 2, 2024), and implementation push (August 12, 2024). Each cohort is normalized to zero at $\tau = -1$; CARs accumulate from $\tau = -12$. The launch event (February 2024) produces a negative 12-month CAR of $-0.289$ P/B points, indicating that Korea's P/B fell relative to Japan in the first year. The guidelines and implementation push cohorts show positive CARs over the extended window, partly reflecting TOPIX-specific dynamics discussed in the text. Compare with Figure~5 (MSCI EM Asia spread) for the unconfounded result.}}{17}{}\protected@file@percent }
\newlabel{fig:korea_es_topix}{{4}{17}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{KOSPI--MSCI EM Asia spread.}{18}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Robustness}{18}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Window sensitivity.}{18}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cumulative abnormal KOSPI--MSCI EM Asia P/B spreads for Korea's three Value-Up reform milestones, using the same stacked cohort design as Figure~4. A negative CAR indicates Korea underperformed regional emerging-market peers relative to pre-event trend. All three cohorts produce persistently negative CARs: the launch reaches $-2.178$ at $\tau = 12$ and $-4.141$ at $\tau = 20$; guidelines reach $-1.804$ at $\tau = 12$; implementation push reaches $-2.121$ at $\tau = 12$. Because MSCI EM Asia carries no TSE-equivalent P/B mandate, these results rule out Japan-specific TOPIX appreciation as the mechanical driver of Korea's relative deterioration.}}{19}{}\protected@file@percent }
\newlabel{fig:korea_es_asia}{{5}{19}{}{}{}}
\newlabel{fig:rob_post12_topix}{{6a}{20}{}{}{}}
\newlabel{sub@fig:rob_post12_topix}{{a}{20}{}{}{}}
\newlabel{fig:rob_post12_asia}{{6b}{20}{}{}{}}
\newlabel{sub@fig:rob_post12_asia}{{b}{20}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Window-sensitivity robustness: Korea Value-Up event study truncated to a 12-month post-event window. CARs at $\tau = 12$ are identical to the primary specification (Figure~4 and Figure~5) by construction. Panel~(a) shows the TOPIX-based spread; Panel~(b) shows the MSCI EM Asia spread. All three MSCI EM Asia CARs remain negative at the 12-month horizon, confirming that the primary result does not depend on the extended 20-month window.}}{20}{}\protected@file@percent }
\newlabel{fig:rob_post12}{{6}{20}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Spaced follow-through.}{20}{}\protected@file@percent }
\newlabel{fig:rob_spaced_topix}{{7a}{21}{}{}{}}
\newlabel{sub@fig:rob_spaced_topix}{{a}{21}{}{}{}}
\newlabel{fig:rob_spaced_asia}{{7b}{21}{}{}{}}
\newlabel{sub@fig:rob_spaced_asia}{{b}{21}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Spaced follow-through robustness: event sequence replaced with the February 2024 program launch, the July 2025 mandatory governance disclosure expansion, and the February 2026 Value-Up dividend disclosure rule. Post-event windows are 2 months for the two most recent events given the April 2026 study endpoint. Panel~(a) uses the TOPIX spread; Panel~(b) uses the MSCI EM Asia spread. The launch cohort replicates the negative primary result ($-0.362$ TOPIX, $-0.468$ MSCI EM Asia at $\tau = 2$). The very short window for the 2025 and 2026 events precludes durable inference.}}{21}{}\protected@file@percent }
\newlabel{fig:rob_spaced}{{7}{21}{}{}{}}
